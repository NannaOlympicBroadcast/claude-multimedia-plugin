# claude-multimedia 配置模板
# 复制到 ~/.config/claude-multimedia/config.env（或项目根目录 .env），chmod 600。
# 真实环境变量优先于本文件。

# ---- Gemini（音视频分析 + Nano Banana 生图）----
GEMINI_API_KEY=
# GEMINI_MODEL=                 # 固定分析模型；留空=自动选最新
# GEMINI_PREFER=latest          # latest|pro|flash|lite
# GEMINI_IMAGE_MODEL=           # 固定 Nano Banana 模型；留空=自动

# ---- OpenAI GPT Image ----
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=           # 留空=自动选最新 gpt-image-*

# ---- Seedream（火山引擎方舟 / BytePlus ModelArk）----
ARK_API_KEY=                    # 国内火山引擎
BYTEPLUS_API_KEY=               # 海外 BytePlus
# SEEDREAM_REGION=cn            # cn|intl
# SEEDREAM_MODEL=               # 例: doubao-seedream-5-0-pro-260628
# SEEDREAM_BASE_URL=

# ---- 生图自动选择 ----
IMAGE_PROVIDER=auto             # auto|openai|gemini|seedream
IMAGE_PROVIDER_ORDER=openai,gemini,seedream
IMAGE_TIER=quality              # quality|fast

# ---- 腾讯云语音识别 ----
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# TENCENT_ASR_ENGINE=16k_zh_en_2.0
# TENCENT_ASR_REGION=

# ---- Edge TTS ----
# EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# EDGE_TTS_PROXY=

# ---- yt-dlp / aria2 ----
YTDLP_CHANNEL=stable            # stable|nightly
# YTDLP_UPDATE_INTERVAL=3600    # 秒，两次更新检查的最短间隔
# YTDLP_COOKIES_FILE=
# YTDLP_COOKIES_FROM_BROWSER=
# YTDLP_PROXY=
ARIA2_CONNECTIONS=16
# ARIA2_ALL_PROXY=
# ARIA2_CA_CERT=
